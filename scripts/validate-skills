#!/usr/bin/env bash
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SKILLS_DIR="$REPO_ROOT/skills"

usage() {
  cat <<'EOF'
usage: validate-skills [--help]

Validate the skills repo:
  cross-references — every markdown link resolves to an existing file
  label consistency — every scope:value pattern matches label-taxonomy.md

exit codes: 0 = all clear, 1 = errors found, 2 = usage error
EOF
  exit 0
}

# --help
if [ $# -gt 0 ]; then
  case "$1" in
    --help|-h) usage ;;
    *)
      echo "error: unknown flag $1 for validate-skills"
      echo "help: validate-skills [--help]"
      exit 2
      ;;
  esac
fi

EXIT=0
results=""

# ── 1. Cross-reference validation ──────────────────────────────────────────

while IFS= read -r file; do
  dir=$(dirname "$file")
  rel=$(realpath --relative-to="$SKILLS_DIR" "$file")
  while IFS=: read -r lineno link; do
    [ -z "$link" ] && continue
    target=$(echo "$link" | sed -E 's/.*\(([^)#]*).*/\1/')
    [ -z "$target" ] && continue
    resolved="$dir/$target"
    if [ ! -f "$resolved" ] && [ ! -d "$resolved" ]; then
      results+="cross-reference,$rel,$lineno,broken link → $target"$'\n'
      EXIT=1
    fi
  done < <(grep -noP '\[[^\]]*\]\((?!/)(?!http)[^)]*\)' "$file" 2>/dev/null || true)
done < <(find "$SKILLS_DIR" -name "*.md")

# ── 2. Label consistency ───────────────────────────────────────────────────

TAXONOMY="$SKILLS_DIR/shared/label-taxonomy.md"
if [ -f "$TAXONOMY" ]; then
  valid=$(awk -F'|' '/^\| `[a-z]+` \| `[a-z-]+` \|/ {
    gsub(/[ `]/, "", $2); gsub(/[ `]/, "", $3);
    print $2 ":" $3
  }' "$TAXONOMY")

  while IFS= read -r file; do
    [[ "$file" == */generated/* ]] && continue
    [[ "$file" == "$TAXONOMY" ]] && continue
    rel=$(realpath --relative-to="$SKILLS_DIR" "$file")
    while IFS=: read -r lineno label; do
      [ -z "$label" ] && continue
      if ! echo "$valid" | grep -qxF "$label"; then
        results+="label,$rel,$lineno,unknown label $label"$'\n'
        EXIT=1
      fi
    done < <(grep -noP '\b(triage|type|kind|wayfinder):[a-z-]+' "$file" 2>/dev/null || true)
  done < <(find "$SKILLS_DIR" -name "*.md")
fi

# ── Output ─────────────────────────────────────────────────────────────────

if [ "$EXIT" -eq 0 ]; then
  echo "errors[0]{check,file,line,message}:"
  echo "help: all checks passed — cross-references resolve, labels match taxonomy"
else
  count=$(echo "$results" | grep -c . || echo 0)
  echo "errors[$count]{check,file,line,message}:"
  echo "$results" | sort -t, -k1,1 -k2,2 -k3,3n | while IFS= read -r line; do
    [ -z "$line" ] && continue
    echo "  $line"
  done
  echo
  echo "help: fix broken links with valid paths; add unknown labels to shared/label-taxonomy.md"
fi

exit "$EXIT"
